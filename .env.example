# Copy to .env. Never put keys in prompts or commit this file once filled.
ANTHROPIC_API_KEY=
# auto: real model if a key is set, otherwise offline mock. Or force: mock | anthropic
VTD_LLM=auto
VTD_MODEL=claude-opus-5-5
VTD_EFFORT=medium
VTD_DEFAULT_BUDGET_USD=2.0
VTD_MAX_FIX_ROUNDS=2
VTD_MAX_REVISIONS=3
VTD_TEST_TIMEOUT=60
VTD_COMPANY=AtusCompany
# Delivery (phase 5). Leave empty to keep emails in the outbox and disable GitHub pushes.
VTD_PUBLIC_URL=http://localhost:8000
VTD_GITHUB_TOKEN=
VTD_SMTP_HOST=
VTD_SMTP_PORT=587
VTD_SMTP_USER=
VTD_SMTP_PASSWORD=
VTD_SMTP_FROM=
